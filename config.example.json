{
  "host": "0.0.0.0",
  "port": 8080,
  "static_dir": "./examples/static",
  "lua_scripts_dir": "./examples/lua",
  "security_headers": true,
  "max_body_size": 10485760,
  "timeout_seconds": 30,
  "thread_pool_size": 4,
  "enable_lua": true,
  "enable_graphql": true,
  "graphql_endpoint": "/graphql",
  "log_level": "info",
  "log_file": "zhttpd.log"
}
