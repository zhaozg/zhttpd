{
  "host": "0.0.0.0",
  "port": 8080,
  "static_dir": "./examples/static",
  "lua_scripts_dir": "./examples/lua",
  "security_headers": true,
  "max_body_size": 10485760,
  "timeout_seconds": 30,
  "thread_pool_size": 4,
  "max_connections": 512,
  "request_buffer_size": 65536,
  "enable_lua": true,
  "enable_graphql": true,
  "graphql_endpoint": "/graphql",
  "log_level": "info",
  "log_file": "zhttpd.log",
  "access_log_file": "access.log",
  "reload": "auto",
  "max_cache_file_size": 1048576,
  "enable_etag": true,
  "enable_metrics": true,
  "enable_health_check": true,
  "enable_request_id": true,
  "log_format": "text",
  "enable_ip_blacklist": false,
  "ip_blacklist": "",
  "ip_whitelist": ""
}
